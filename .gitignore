# Python
.venv/
**/.venv/
__pycache__/
*.pyc
.pytest_cache/
thesis/.docx_deps/

# Node / Next.js
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# Secrets and local config
.env
.env.*
!.env.example

# Editor / agent local state (launch.json is shared, the rest is per-machine)
.claude/settings.local.json
.claude/worktrees/
.idea/
.vscode/

# Logs and OS noise
*.log
.DS_Store

# Regenerable downloads (recreate with scripts/download_ipto_system_load.py)
data/raw/
data/interim/

# Regenerable Overpass response cache (recreate with pipeline/calibrate_power_density.py)
apps/api/data/raw/osm/

# Per-site weather caches: one 184 KB file per location per year, and a
# session can create dozens. Refetched from Open-Meteo's archive on demand.
# The price cache beside them IS committed -- one file per year, and a
# deployment with no outbound access still needs it.
apps/api/data/generated/hourly_series/weather_*.json

# Raw IPTO/ADMIE market spreadsheets, cached by file name because a published
# file never changes. ~14 MB and growing, and every one is a few hundred
# milliseconds to refetch, so this is a pure intermediate: the assembled
# balancing year beside it is the artefact worth keeping.
apps/api/data/generated/ipto/
