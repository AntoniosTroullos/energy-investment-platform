{
  "name": "energy-investment-platform",
  "private": true,
  "description": "Repo-level commands. The web app has its own package in apps/web; the API is Python in apps/api.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node scripts/dev.mjs --api-only",
    "dev:web": "node scripts/dev.mjs --web-only",
    "doctor": "node scripts/doctor.mjs",
    "doctor:deep": "node scripts/doctor.mjs --deep",
    "test": "node scripts/test.mjs",
    "test:api": "node scripts/test.mjs --api",
    "test:web": "node scripts/test.mjs --web"
  },
  "engines": {
    "node": ">=20"
  }
}
